{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../out",
      "cacheVariables": {
        "CMAKE_INTERMEDIATE_DIR_STRATEGY": "SHORT"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "Word x64 Debug",
      "inherits": "x64"
    },
    {
      "name": "x64-release",
      "displayName": "Word x64 Release",
      "inherits": "x64"
    },
    {
      "name": "ninja-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERMEDIATE_DIR_STRATEGY": "SHORT"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "Word macOS Debug",
      "inherits": "ninja-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Word Linux Debug",
      "inherits": "ninja-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "Word WebAssembly Debug",
      "inherits": "ninja-debug",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Emscripten",
        "CMAKE_C_COMPILER": "emcc",
        "CMAKE_CXX_COMPILER": "em++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    }
  ]
}
